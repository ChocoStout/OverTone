<Project>

  <!--
    Central Package Management (CPM): one source of truth for every NuGet version in the
    repository. Projects reference packages with no Version attribute.
    https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive pinning is left OFF: these are libraries, so transitive deps (e.g. StbImageSharp
         flowing through the OverTone reference) should stay transitive, not be surfaced as direct
         package dependencies in the produced .nupkg. -->
  </PropertyGroup>

  <!-- Library dependencies -->
  <ItemGroup>
    <PackageVersion Include="StbImageSharp" Version="2.30.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
  </ItemGroup>

  <!-- Test dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

</Project>
