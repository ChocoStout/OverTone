<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OverTone — Palette Explorer</title>
    <base href="/" />
    <HeadOutlet />
    <style>
        * { box-sizing: border-box; }
        body { font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; margin: 0; padding: 2rem; color: #1c1c22; background: #fafafa; }
        h1 { margin: 0 0 .25rem; font-size: 1.6rem; }
        .sub { margin: 0 0 1.5rem; color: #666; max-width: 60ch; }
        .controls { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; margin-bottom: 1.25rem; }
        .controls label { display: inline-flex; gap: .4rem; align-items: center; font-size: .9rem; }
        .controls select, .controls input[type=number], .controls input[type=url] { border: 1px solid #ccc; border-radius: 6px; padding: .35rem .5rem; }
        .controls input[type=number] { width: 4rem; }
        .controls input[type=url] { width: 15rem; }
        .url-group { display: inline-flex; gap: .4rem; align-items: center; }
        .btn { border: 1px solid #ccc; background: #fff; border-radius: 6px; padding: .45rem .8rem; cursor: pointer; font-size: .9rem; }
        .btn.primary { background: #285ad2; color: #fff; border-color: #285ad2; }
        .btn:disabled { opacity: .5; cursor: default; }
        .error { background: #fdecea; color: #b3261e; padding: .6rem .8rem; border-radius: 6px; margin-bottom: 1rem; }
        .hint { color: #888; }
        .result { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: flex-start; }
        .source img { max-width: 460px; max-height: 460px; border-radius: 10px; box-shadow: 0 2px 12px rgba(0,0,0,.14); display: block; }
        .source figcaption { margin-top: .5rem; color: #777; font-size: .85rem; max-width: 460px; }
        .palette { flex: 1; min-width: 280px; }
        .strip { display: flex; height: 56px; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,.14); margin-bottom: 1rem; }
        .strip .seg { min-width: 2px; }
        .swatches { list-style: none; margin: 0; padding: 0; }
        .swatches li { display: flex; align-items: center; gap: .75rem; padding: .4rem 0; border-bottom: 1px solid #eee; }
        .chip { width: 30px; height: 30px; border-radius: 6px; border: 1px solid rgba(0,0,0,.18); flex: none; }
        .hex { font-family: ui-monospace, "SF Mono", Consolas, monospace; font-size: .9rem; width: 5.5rem; }
        .name { flex: 1; color: #333; }
        .pct { color: #777; font-variant-numeric: tabular-nums; }
        .meta { margin-top: 1rem; color: #888; font-size: .85rem; }
        .nav { display: flex; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid #e3e3e3; padding-bottom: .6rem; }
        .nav a { text-decoration: none; color: #285ad2; font-weight: 600; }
        .controls input[type=color] { width: 3rem; height: 2.1rem; padding: 0; border: 1px solid #ccc; border-radius: 6px; background: none; cursor: pointer; }
        .controls input[type=text] { border: 1px solid #ccc; border-radius: 6px; padding: .35rem .5rem; width: 8rem; font-family: ui-monospace, Consolas, monospace; }
        .toggle { display: inline-flex; gap: .25rem; }
        .toggle .btn.on { background: #285ad2; color: #fff; border-color: #285ad2; }
        h3 { margin: 1.5rem 0 .5rem; font-size: 1.05rem; }
        .roles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .75rem; margin: 1rem 0; }
        .role { border-radius: 10px; padding: 1rem .9rem; min-height: 74px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 1px 4px rgba(0,0,0,.12); }
        .role-name { font-weight: 600; }
        .role-hex { font-family: ui-monospace, Consolas, monospace; font-size: .8rem; opacity: .85; }
        .ramp { display: flex; align-items: center; gap: .5rem; margin: .35rem 0; }
        .ramp-label { width: 6rem; font-size: .85rem; color: #444; }
        .shade { flex: 1; height: 28px; border-radius: 4px; border: 1px solid rgba(0,0,0,.1); }
        .css { background: #1c1c22; color: #e6e6e6; padding: 1rem; border-radius: 10px; overflow-x: auto; font-size: .78rem; max-height: 360px; }
    </style>
</head>
<body>
    <nav class="nav">
        <a href="/">Palette</a>
        <a href="/theme">Theme</a>
    </nav>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
