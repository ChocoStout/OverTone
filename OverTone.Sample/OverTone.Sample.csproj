<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <!-- Assembly identity -->
    <AssemblyName>OverTone.Sample</AssemblyName>
    <RootNamespace>OverTone.Sample</RootNamespace>
    <AssemblyTitle>OverTone Sample — Color Palette Extractor Demo</AssemblyTitle>
    <Description>Interactive, cross-platform console demo for the OverTone color palette extraction library.</Description>

    <!-- Self-contained single-file publish profile hint -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OverTone\OverTone.csproj" />
  </ItemGroup>

</Project>
