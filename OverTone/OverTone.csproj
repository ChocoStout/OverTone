<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- NuGet package identity -->
    <PackageId>OverTone</PackageId>
    <Title>OverTone — Color Palette Extractor</Title>
    <Description>
      Extract region-aware, perceptually distinct color palettes from images using image-space
      segmentation — SLIC superpixels and spatial 5D K-Means — with peak (not averaged) region colors
      and a saliency-ranked GetColors entry point. Supports local files and URLs. Async-first;
      dependency-free core (only StbImageSharp, for decoding).
    </Description>
    <PackageTags>color;palette;extraction;image;slic;superpixel;segmentation;kmeans;oklab</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ChocoStout/OverTone</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

</Project>
